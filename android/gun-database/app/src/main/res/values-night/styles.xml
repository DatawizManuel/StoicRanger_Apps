<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark variant: the WebView only reports prefers-color-scheme: dark when the app theme is dark. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_bg</item>
        <item name="android:statusBarColor">@color/night_bg</item>
        <item name="android:navigationBarColor">@color/night_bg</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorPrimary">@color/gold</item>
    </style>
</resources>
